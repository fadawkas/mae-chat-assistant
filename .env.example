# Mae — Environment Configuration
# Copy to .env and fill in real values.

# OpenRouter
MAE_OPENROUTER_API_KEY=sk-or-v1-placeholder
MAE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAE_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
MAE_COUNCIL_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o,google/gemini-2.0-flash-exp

# Search (Tavily or Brave Search API)
MAE_SEARCH_API_KEY=

# Database
MAE_DATABASE_URL=postgresql+asyncpg://mae:mae@postgres:5432/mae

# Redis
MAE_REDIS_URL=redis://redis:6379/0

# Output directory for generated files
MAE_OUTPUT_DIR=/data/outputs
MAE_UPLOAD_DIR=/data/uploads
MAE_MAX_UPLOAD_BYTES=10485760
MAE_SANDBOX_URL=http://mae-sandbox:9000
MAE_DOCUMENT_AGENT_MODEL=openai/gpt-4o
MAE_SANDBOX_TIMEOUT_SECONDS=90

# Accounts and encrypted user provider keys. Generate a long random value.
MAE_ENCRYPTION_KEY=replace-with-a-long-random-secret
MAE_SESSION_TTL_DAYS=30
MAE_COOKIE_SECURE=false
MAE_RATE_LIMIT_PER_MINUTE=60

# Automation schedules are managed in the Mae UI. Cron expressions use UTC or
# the IANA timezone saved with each schedule (for example, America/New_York).
